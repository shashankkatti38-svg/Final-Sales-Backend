model rbac_role_definitions {
  id               String   @id @default(dbgenerated("gen_random_uuid()::text"))
  role_key         String   @unique(map: "rbac_role_definitions_role_key_key")
  legacy_role_name String   @unique(map: "rbac_role_definitions_legacy_role_name_key")
  is_platform_role Boolean  @default(false)
  is_active        Boolean  @default(true)
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user_role_assignments user_roles[]             @relation("user_role_definition")
  role_permissions      rbac_role_permissions[]

  @@unique([id, legacy_role_name], map: "rbac_role_definitions_id_legacy_name_unique")
  @@map("rbac_role_definitions")
}

model rbac_permission_definitions {
  id             String   @id @default(dbgenerated("gen_random_uuid()::text"))
  permission_key String   @unique(map: "rbac_permission_definitions_permission_key_key")
  category       String
  resource       String
  action         String
  description    String?
  is_active      Boolean  @default(true)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  role_permissions rbac_role_permissions[]

  @@unique([category, resource, action], map: "rbac_permission_category_resource_action_unique")
  @@map("rbac_permission_definitions")
}

model rbac_role_permissions {
  id                       String   @id @default(dbgenerated("gen_random_uuid()::text"))
  role_definition_id       String
  permission_definition_id String
  data_scope               RbacDataScope
  created_at               DateTime @default(now()) @db.Timestamptz(6)
  created_by               String?

  role_definition rbac_role_definitions @relation(fields: [role_definition_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  permission_definition rbac_permission_definitions @relation(fields: [permission_definition_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  creator profiles? @relation("rbac_role_permission_created_by", fields: [created_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@unique([role_definition_id, permission_definition_id, data_scope], map: "rbac_role_permissions_unique")
  @@index([permission_definition_id, role_definition_id], map: "rbac_role_permissions_permission_idx")
  @@map("rbac_role_permissions")
}

model rbac_user_account_status {
  user_id    String   @id
  status     RbacAccountStatus
  reason     String?
  changed_by String?
  changed_at DateTime @default(now()) @db.Timestamptz(6)

  user profiles @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  changer profiles? @relation("rbac_user_account_status_changed_by", fields: [changed_by], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([status, changed_at], map: "rbac_user_account_status_status_idx")
  @@map("rbac_user_account_status")
}

model rbac_audit_log {
  id                       String   @id @default(dbgenerated("gen_random_uuid()::text"))
  organization_id          String?
  actor_user_id            String?
  subject_user_id          String?
  role_definition_id       String?
  permission_definition_id String?
  event_name               String
  before_values            Json?
  after_values             Json?
  occurred_at              DateTime @default(now()) @db.Timestamptz(6)

  @@index([organization_id, occurred_at(sort: Desc)], map: "rbac_audit_log_organization_time_idx")
  @@index([subject_user_id, occurred_at(sort: Desc)], map: "rbac_audit_log_subject_time_idx")
  @@index([actor_user_id, occurred_at(sort: Desc)], map: "rbac_audit_log_actor_time_idx")
  @@index([event_name, occurred_at(sort: Desc)], map: "rbac_audit_log_event_time_idx")
  @@map("rbac_audit_log")
}
