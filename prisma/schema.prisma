generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RbacDataScope {
  PLATFORM
  ORGANIZATION
  TEAM
  REPORTING_TREE
  ASSIGNED
  PROJECT_MEMBER
  OWN
  NONE

  @@map("rbac_data_scope")
}

enum RbacAccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  INVITED
  PENDING_VERIFICATION

  @@map("rbac_account_status")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Organization {
  id                       String    @id
  owner_id                 String?
  name                     String?
  created_at               DateTime? @db.Timestamptz(6)
  followup_enabled         String?
  followup_days            BigInt?
  bank_details             String?
  invite_code              String?
  auto_assign              String?
  rr_cursor                BigInt?
  recording_retention_days BigInt?
  shift_start              String?
  shift_end                String?   @default("18:30:00")
  status                   String?   @default("ACTIVE")
  deleted_at               DateTime? @db.Timestamptz(6)
  website                  String?
  phone                    String?
  industry                 String?
  address                  String?
  city                     String?
  state                    String?
  country                  String?   @default("India")
  tax_id                   String?
  plan                     String?   @default("ENTERPRISE")
}

